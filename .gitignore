# ============================================
# SECRETS & CONFIGURATION (le plus important)
# ============================================
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
local_settings.py
settings_local.py

# ============================================
# PYTHON
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Environnements virtuels
venv/
env/
.venv/
ENV/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ============================================
# DJANGO
# ============================================
# Bases de données locales
db.sqlite3
db.sqlite3-journal
*.sqlite3
*.db

# Fichiers uploadés par les utilisateurs (photos produits, PDF, couvertures de livres...)
media/

# Fichiers statiques générés par collectstatic
staticfiles/
static_root/

# Logs
*.log
logs/

# Cache
.cache/
*.pyc

# ============================================
# TESTS & COUVERTURE
# ============================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/

# ============================================
# FRONTEND (si tu utilises npm / Tailwind / etc.)
# ============================================
node_modules/
npm-debug.log*
yarn-error.log
.parcel-cache/

# ============================================
# ÉDITEURS & IDE
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================
# SYSTÈME D'EXPLOITATION
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# SAUVEGARDES & FICHIERS TEMPORAIRES
# ============================================
*.bak
*.tmp
*.sql
*.dump
